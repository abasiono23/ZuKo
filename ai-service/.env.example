# ---- Service ----
# Shared secret the Node.js backend sends as the X-Service-Key header. Leave empty only for local dev.
ZUKO_SERVICE_KEY=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- AI (OpenAI: parsing + coach) ----
# Get a key at https://platform.openai.com/api-keys. Without one, the service falls back to the rules engine.
OPENAI_API_KEY=
ZUKO_AI_ENABLED=true
# Leave empty for the default (gpt-5.5).
ZUKO_AI_MODEL=
ZUKO_PARSE_EFFORT=low
ZUKO_COACH_EFFORT=medium

# ---- BMONI (Embedded API, docs: https://embedded-dev.bmoni.com/docs) ----
# mock = built-in test data (no network). sandbox = call the real BMONI sandbox.
BMONI_MODE=mock
BMONI_BASE_URL=https://embedded-dev.bmoni.com
# Partner API key, sent as the x-api-key header. Keep it server-side only, never in the frontend.
BMONI_API_KEY=
BMONI_SECRET_KEY=
BMONI_AUTH_SCHEME=x-api-key
# BMONI user id of the demo student (from POST /v1/users). Per-student ids come from Supabase.
BMONI_USER_ID=
# Wallet currencies treated as naira (CNGN is BMONI's naira stablecoin).
BMONI_NAIRA_CURRENCIES=CNGN,NGN
# {user_id} and {wallet_id} are substituted. Leave empty to use the defaults in app/config.py.
BMONI_PATH_WALLETS=/v1/users/{user_id}/smart-wallets/account/wallets
BMONI_PATH_BALANCE=/v1/users/{user_id}/smart-wallets/{wallet_id}/balance
BMONI_PATH_TRANSACTIONS=/v1/users/{user_id}/transactions/{wallet_id}
# Smart-wallet amounts are decimal strings in whole units (e.g. "24500.000000").
BMONI_AMOUNT_UNIT=naira
BMONI_TIMEOUT_S=15

# ---- Student defaults ----
ZUKO_DEFAULT_CUSHION=3000
ZUKO_MIN_DAILY_SUBSISTENCE=1200
